# --- Required ---------------------------------------------------------------
# SQLite file locally, or a libSQL/Turso URL in production
DATABASE_URI=file:./yl-website.db
# DATABASE_AUTH_TOKEN=
PAYLOAD_SECRET=change-me-to-a-long-random-string
# Public URL of the site (used by the admin live preview and SEO metadata)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# --- Media storage (S3 / Cloudflare R2). Leave S3_BUCKET empty to store files locally in /media
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
S3_ENDPOINT=
# Optional: public bucket URL; when set, images are served directly from it
NEXT_PUBLIC_CLOUDFLARE_PUB_URL=

# --- Email (Mailtrap) ---------------------------------------------------------
MAILTRAP_API_KEY=your_api_key_here
MAILTRAP_SENDER_EMAIL=info@yl-association.org
MAILTRAP_SENDER_NAME="Young Leaders Association"
EMAIL_RECEIVER=contact@yl-association.org
